{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "outcomes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "status", "reason", "summary", "reviews"],
        "properties": {
          "project_id": { "type": "string" },
          "status": { "type": "string", "enum": ["succeeded", "not-applicable"] },
          "reason": { "type": "string" },
          "summary": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["overview", "themes", "decisions", "pitfalls", "playbook", "conflicts", "boundaries", "open_questions"],
                "properties": {
                  "overview": { "type": "string" },
                  "themes": { "type": "string" },
                  "decisions": { "type": "string" },
                  "pitfalls": { "type": "string" },
                  "playbook": { "type": "string" },
                  "conflicts": { "type": "string" },
                  "boundaries": { "type": "string" },
                  "open_questions": { "type": "string" }
                }
              }
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "disposition", "reason"],
              "properties": {
                "path": { "type": "string" },
                "disposition": { "type": "string", "enum": ["keep-active", "archive"] },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
